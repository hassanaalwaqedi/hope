# HOPE Backend - Production Environment Template
# ==============================================================================
# COPY THIS FILE to .env.production and fill in real values
# NEVER commit actual secrets to version control
# ==============================================================================

# =============================================================================
# ENVIRONMENT IDENTIFICATION
# =============================================================================
HOPE_ENV=production
HOPE_DEBUG=false
HOPE_LOG_LEVEL=INFO
HOPE_API_VERSION=v1

# Allowed origins for CORS (comma-separated for production)
HOPE_CORS_ORIGINS=["https://hope-app.com","https://api.hope-app.com"]

# =============================================================================
# DATABASE - PostgreSQL (Production)
# =============================================================================
# Use managed PostgreSQL (Cloud SQL, RDS, etc.)
HOPE_DB_HOST=your-db-host.region.cloud.provider.com
HOPE_DB_PORT=5432
HOPE_DB_NAME=hope_production
HOPE_DB_USER=hope_app
HOPE_DB_PASSWORD=<SECURE_PASSWORD_FROM_SECRETS_MANAGER>
HOPE_DB_POOL_SIZE=20
HOPE_DB_MAX_OVERFLOW=40
HOPE_DB_SSL_MODE=require

# Field-level encryption key (32 bytes, base64 encoded)
# CRITICAL: Generate securely, store in secrets manager
# Generate: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
HOPE_ENCRYPTION_KEY=<GENERATE_AND_STORE_IN_SECRETS_MANAGER>

# =============================================================================
# AUTHENTICATION - JWT (Production)
# =============================================================================
# CRITICAL: Use secrets manager for these values
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
HOPE_JWT_SECRET_KEY=<GENERATE_AND_STORE_IN_SECRETS_MANAGER>
HOPE_JWT_ALGORITHM=HS256
HOPE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
HOPE_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# LLM PROVIDERS (Production)
# =============================================================================
HOPE_LLM_PRIMARY_PROVIDER=gemini_flash

# Google Gemini - REQUIRED
# Get from: https://makersuite.google.com/app/apikey
HOPE_GEMINI_API_KEY=<GET_FROM_GOOGLE_AI_STUDIO>
HOPE_GEMINI_MODEL=gemini-1.5-flash

# OpenAI - Fallback (Optional)
HOPE_OPENAI_API_KEY=<OPTIONAL_FALLBACK>
HOPE_OPENAI_MODEL=gpt-4-turbo-preview

# =============================================================================
# RATE LIMITING (Production - Stricter)
# =============================================================================
HOPE_RATE_LIMIT_ENABLED=true
HOPE_RATE_LIMIT_REQUESTS_PER_MINUTE=30
HOPE_RATE_LIMIT_BURST=10
HOPE_RATE_LIMIT_VOICE_PER_MINUTE=20

# =============================================================================
# SAFETY SYSTEMS (Production - All Enabled)
# =============================================================================
HOPE_SAFETY_HARD_FILTER_ENABLED=true
HOPE_AUDIT_LOG_ENABLED=true
HOPE_CRISIS_ESCALATION_ENABLED=true

# =============================================================================
# OBSERVABILITY (Production)
# =============================================================================
# Sentry Error Tracking - HIGHLY RECOMMENDED
HOPE_SENTRY_DSN=<GET_FROM_SENTRY_PROJECT>
HOPE_SENTRY_ENVIRONMENT=production
HOPE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Metrics Export
HOPE_METRICS_ENABLED=true
HOPE_METRICS_PORT=9090

# =============================================================================
# BETA LIMITS (Remove after full launch)
# =============================================================================
HOPE_BETA_MODE=true
HOPE_BETA_MAX_USERS=100
HOPE_BETA_DAILY_MESSAGE_LIMIT=50
HOPE_BETA_REQUIRE_DISCLAIMER_ACCEPT=true
