# ========================
# HOPE Backend - Environment Variables
# Copy this file to .env and fill in your values
# ========================

# Application Environment
HOPE_ENV=production
HOPE_DEBUG=false
HOPE_LOG_LEVEL=INFO

# JWT Authentication (REQUIRED - no defaults)
HOPE_JWT_SECRET_KEY=<generate-a-256-bit-secret-key>

# Database Configuration (REQUIRED)
HOPE_DB_HOST=localhost
HOPE_DB_PORT=5432
HOPE_DB_NAME=hope_db
HOPE_DB_USER=hope_user
HOPE_DB_PASSWORD=<strong-database-password>

# Encryption (REQUIRED - must be exactly 32 bytes)
HOPE_ENCRYPTION_KEY=<32-byte-encryption-key>

# AI Provider
HOPE_GEMINI_API_KEY=<your-gemini-api-key>

# CORS (JSON array of allowed origins)
HOPE_CORS_ORIGINS=["https://your-frontend-domain.com"]

# Rate Limiting
HOPE_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Sentry (optional)
SENTRY_DSN=

# Docker / Gunicorn
WEB_CONCURRENCY=4
PORT=8000
