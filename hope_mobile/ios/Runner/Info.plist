<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Identity -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>HOPE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>HOPE</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	
	<!-- CRITICAL: Microphone Permission (Required for voice panic support) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>HOPE uses the microphone for voice-based panic support. This allows hands-free interaction when you're unable to type during a panic episode. Your audio is processed locally and only transcribed text is sent to our secure servers.</string>
	
	<!-- CRITICAL: Speech Recognition Permission -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>HOPE uses speech recognition to understand your voice during panic episodes. This enables hands-free breathing guidance and crisis support when you need it most.</string>
	
	<!-- Background Audio Mode (keeps listening when screen locked) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
	
	<!-- Audio Session Configuration Hints -->
	<key>AVAudioSessionCategory</key>
	<string>AVAudioSessionCategoryPlayAndRecord</string>
	<key>AVAudioSessionMode</key>
	<string>AVAudioSessionModeVoiceChat</string>
	<key>AVAudioSessionRouteSharingPolicy</key>
	<string>AVAudioSessionRouteSharingPolicyDefault</string>
	
	<!-- UI Configuration -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
